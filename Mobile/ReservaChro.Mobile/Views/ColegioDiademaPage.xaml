<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ReservaChro.Mobile.Views.ColegioDiademaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Colégio Adventista de Diadema"
    BackgroundColor="#06121f">

    <Grid RowDefinitions="70, *">

        <!-- TOP BAR -->
        <Grid Grid.Row="0"
                BackgroundColor="#071a2b"
                Padding="16"
                ColumnDefinitions="Auto,*,Auto">
            <!-- Left: Avatar + user info -->
            <HorizontalStackLayout Spacing="12"
                    VerticalOptions="Center">
                <Frame WidthRequest="40"
                        HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="#0b2a4a"
                       Padding="0"
                       HasShadow="False"
                       VerticalOptions="Center">
                    <Label Text="👤"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            FontSize="16"/>
                </Frame>

                <VerticalStackLayout Spacing="0"
                        VerticalOptions="Center">
                    <Label x:Name="UserNameLabel"
                           Text="Professor Silva"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="16"/>
                    <Label x:Name="UserRoleLabel"
                           Text="Professor"
                           TextColor="#8fb6ff"
                           FontSize="12"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Right: Logout -->
            <HorizontalStackLayout Grid.Column="2"
                    Spacing="8"
                    VerticalOptions="Center">
                <Label Text="Sair"
                        TextColor="#ff6b6b"
                        VerticalOptions="Center"/>
                <Button Text="⎋"
                        BackgroundColor="Transparent"
                        TextColor="#ff6b6b"
                        Clicked="OnLogoutClicked"
                        Padding="0"
                        WidthRequest="40"
                        HeightRequest="40"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- BODY -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20"
                    Spacing="18">

                <!-- Header image + titles -->
                <VerticalStackLayout Spacing="10"
                        HorizontalOptions="Center">
                    <Frame WidthRequest="90"
                            HeightRequest="90"
                           CornerRadius="18"
                           Padding="0"
                           HasShadow="True"
                           BackgroundColor="#0b2a4a">
                        <Image x:Name="SchoolLogoImage"
                               Source="colegiocad.png"
                               Aspect="AspectFill"/>
                    </Frame>

                    <Label Text="Colégio Adventista de Diadema"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="22"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Agendamento de Chromebooks"
                           TextColor="#8fb6ff"
                           FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Card -->
                <Frame CornerRadius="16"
                       BackgroundColor="#1b2b45"
                       HasShadow="False"
                       Padding="16">

                    <VerticalStackLayout Spacing="14">

                        <!-- Data -->
                        <Label Text="📅  Data"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"/>
                        <DatePicker x:Name="DatePickerReserva"
                                    TextColor="White"
                                    BackgroundColor="#2a3a57"/>

                        <!-- Horário -->
                        <Label Text="🕒  Horário"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"/>
                        <Picker x:Name="HorarioPicker"
                                Title="Selecione o horário"
                                TextColor="White"
                                BackgroundColor="#2a3a57"/>

                        <!-- Quantidade -->
                        <Label Text="💻  Quantidade de Chromebooks"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"/>
                        <Entry x:Name="QuantidadeEntry"
                               Placeholder="Ex: 10"
                               Keyboard="Numeric"
                               TextColor="White"
                               PlaceholderColor="#93a4c7"
                               BackgroundColor="#2a3a57"/>

                        <!-- Confirm -->
                        <Button Text="Confirmar Agendamento"
                                BackgroundColor="#1b63ff"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnConfirmarClicked"/>

                        <!-- Info -->
                        <Frame CornerRadius="12"
                                BackgroundColor="#223654"
                                HasShadow="False"
                                Padding="12">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="💡"
                                        FontSize="14"
                                        VerticalOptions="Center"/>
                                <Label Text="Você pode agendar até 40 Chromebooks por horário"
                                       TextColor="#cfe0ff"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- My reservations -->
                <Button Text="Ver Minhas Reservas"
                        BackgroundColor="#1b2b45"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48"
                        Clicked="OnMinhasReservasClicked"/>

                <!-- Bottom image (opcional) -->
                <Frame CornerRadius="16"
                        Padding="0"
                        HasShadow="False"
                        BackgroundColor="#0b2a4a"
                        HeightRequest="120">
                    <Image Source="colegiocad.png"
                            Aspect="AspectFill"
                            Opacity="0.25"/>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
